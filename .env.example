# Sahay Environment Configuration

# Application Mode
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Backend Configuration
PROJECT_NAME="Sahay Backend"
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sahay_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sahay_db"

# LLM & Embedding Provider Configuration
LLM_PROVIDER=mock # Options: mock, openai, gemini, anthropic
LLM_API_KEY=mock_key
EMBEDDING_PROVIDER=mock # Options: mock, openai, gemini

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# TTE Sandbox Security
TTE_ALLOW_UNAPPROVED_EXECUTION=false
TTE_SANDBOX_TIMEOUT_SECONDS=5
